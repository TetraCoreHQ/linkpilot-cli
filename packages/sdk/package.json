{
  "name": "@uselinkpilot/sdk",
  "version": "0.1.0",
  "description": "Typed client for the LinkPilot API v1. Encrypts secret links in your process; LinkPilot never receives the key.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TetraCoreHQ/linkpilot-cli.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://uselinkpilot.com/developers",
  "bugs": {
    "url": "https://github.com/TetraCoreHQ/linkpilot-cli/issues"
  },
  "keywords": [
    "linkpilot",
    "secret",
    "secrets",
    "secret-link",
    "one-time-secret",
    "burn-after-reading",
    "end-to-end-encryption",
    "e2ee",
    "aes-gcm",
    "share-secret",
    "password-sharing",
    "url-shortener",
    "short-links",
    "sdk"
  ],
  "author": "TetraCore"
}
